# Spwrite install-script runtime artifacts (background mode)
# `*.log` above already covers spwrite-*.log; the PID files are added here.
spwrite-*.pid
spwrite-*.log.err

# Built/copied app bundles left in the project root (e.g. Spwrite.app copied
# out of build/ for convenience). The real build output lives under build/,
# which is already ignored; these are just throwaway copies.
/*.app
/Spwrite.app
# Local audit / review notes (never committed).
semantic-review/
# Downloaded local-model weights (GGUF), wherever they land in the tree.
*.gguf
/integration_test/**/*.gguf
# Test coverage output.
coverage/
